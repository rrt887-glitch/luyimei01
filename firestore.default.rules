rules_version = '2';

// The project's (default) Firestore database. The site's data lives in the named database
// (firestore.rules); this one only holds upload_grants/{uid}, written by Cloud Functions and read by
// storage.rules. No browser may read or write anything here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
