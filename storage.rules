rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Product media may be written only by a super admin holding a current upload grant.
    //
    // The grant (`uploadUntil`, epoch ms) is put into the custom claims by the grantUploadAccess
    // Cloud Function, which checks the staff document live each time; the console asks for it
    // before every upload and renews it during long ones. Claims and the request time are the only
    // inputs, both documented and reliable in Storage rules (no cross-service lookup of the named
    // Firestore database, no reliance on JWT time fields). A suspended admin can no longer obtain
    // a grant; a file they still manage to upload with an old grant is removed by the server at once.
    function canWriteMedia() {
      return request.auth != null &&
        request.auth.token.get('role', '') == 'super_admin' &&
        request.auth.token.get('staff', false) == true &&
        request.auth.token.get('uploadUntil', 0) > request.time.toMillis() &&
        // Every file names its uploader, so the onProductMediaUploaded function can check that
        // person against the live staff record the moment the file is stored (and remove it).
        request.resource.metadata != null &&
        request.resource.metadata.get('uploaderUid', '') == request.auth.uid;
    }

    // Product Images: public read, super_admin write, max 10MB, image/* content type only
    match /products/{productId}/images/{fileName} {
      allow read: if true;
      allow create, update: if canWriteMedia() &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      // Deleting goes through the deleteProductMedia Cloud Function (live staff check).
      allow delete: if false;
    }

    // Product Videos: public read, super_admin write, max 150MB, video/* content type only
    match /products/{productId}/videos/{fileName} {
      allow read: if true;
      allow create, update: if canWriteMedia() &&
        request.resource.size <= 150 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
      allow delete: if false;
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
