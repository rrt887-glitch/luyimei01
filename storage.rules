rules_version = '2';

// NOTE: The Firestore database ID below MUST stay identical to `firestoreDatabaseId` in
// firebase-applet-config.json and `firestore.database` in firebase.json.
// tests/config.consistency.test.ts enforces this automatically.

service firebase.storage {
  match /b/{bucket}/o {

    function staffDocPath() {
      return /databases/ai-studio-cardcorner-bf216942-1486-4ef1-bcb0-4a7b0673efe2/documents/staff/$(request.auth.uid);
    }

    // Firebase Storage `firestore.get()` cannot read non-(default) named Firestore databases in
    // production, so we check server-managed Custom Claims (`role: 'super_admin', staff: true`,
    // kept in sync and revoked on suspension/deletion by `syncAuthWithStaffState` in Cloud Functions)
    // first, with `staffDocPath()` retained as fallback.
    function isSuperAdmin() {
      return request.auth != null && (
        (request.auth.token.get('role', '') == 'super_admin' &&
         request.auth.token.get('staff', false) == true) ||
        (firestore.exists(staffDocPath()) &&
         firestore.get(staffDocPath()).data.role == 'super_admin' &&
         firestore.get(staffDocPath()).data.get('status', 'active') == 'active')
      );
    }

    // Product Images: public read, super_admin write, max 10MB, image/* content type only
    match /products/{productId}/images/{fileName} {
      allow read: if true;
      allow create, update: if isSuperAdmin() &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isSuperAdmin();
    }

    // Product Videos: public read, super_admin write, max 150MB, video/* content type only
    match /products/{productId}/videos/{fileName} {
      allow read: if true;
      allow create, update: if isSuperAdmin() &&
        request.resource.size <= 150 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
      allow delete: if isSuperAdmin();
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
